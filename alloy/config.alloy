// =====================================================================
// 1. RECEIVERS & EXPORTERS (TRACES / TEMPO)
// =====================================================================
otelcol.receiver.otlp "default" {
  grpc {}
  http {}

  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"

    tls {
      insecure = true
    }
  }
}

// =====================================================================
// 2. LOGS DO DEMO (SPRING BOOT)
// =====================================================================
loki.source.file "spring_logs" {
  targets = [
    {
      __path__ = "/var/log/spring/app.log",
      app      = "spring-boot",
    },
  ]
  forward_to = [loki.process.parse_demo_json.receiver]
}

loki.process "parse_demo_json" {
  stage.json {
    expressions = {
      traceId = "mdc.trace_id",
      spanId  = "mdc.span_id",
      level   = "level",
    }
  }

  stage.labels {
    values = {
      traceId = "",
      spanId  = "",
      level   = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// =====================================================================
// 3. LOGS DA READ-API
// =====================================================================
loki.source.file "api_logs" {
  targets = [
    {
      __path__ = "/var/log/api-spring/api-spring.log",
      app      = "read-api",
    },
  ]
  forward_to = [loki.process.parse_api_json.receiver]
}

loki.process "parse_api_json" {
  stage.json {
    expressions = {
      traceId = "mdc.trace_id",
      spanId  = "mdc.span_id",
      level   = "level",
    }
  }

  stage.labels {
    values = {
      traceId = "",
      spanId  = "",
      level   = "",
    }
  }

  forward_to = [loki.write.local.receiver]
}

// =====================================================================
// 4. CLIENT EXPORTER (LOKI)
// =====================================================================
loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
